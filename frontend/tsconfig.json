{
  "compilerOptions": {
    "target": "ES2022", "useDefineForClassFields": true, "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "jsx": "preserve", "skipLibCheck": true, "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowImportingTsExtensions": true, "resolveJsonModule": true, "isolatedModules": true,
    "noEmit": true, "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts"]
}
